# Banco de dados
DATABASE_URL="postgresql://university:university123@localhost:5432/university_access"

# JWT
JWT_SECRET="troque-por-uma-chave-secreta-longa-e-aleatoria"
JWT_EXPIRES_IN="8h"

# Servidor
PORT=3000
NODE_ENV=development

# MQTT (Mosquitto rodando via docker-compose)
MQTT_BROKER_URL="mqtt://localhost:1883"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000   # 15 minutos
RATE_LIMIT_MAX=100            # máx requisições por janela por IP
