DATABASE_URL="postgresql://user:password@localhost:5432/university_access"
JWT_SECRET="your-super-secret-key-change-in-production"
JWT_EXPIRES_IN="8h"
MQTT_BROKER_URL="mqtt://localhost:1883"

# Porta em que o servidor Node.js vai escutar
# ATENÇÃO: o frontend está configurado para usar a porta 3000
PORT=3000

# Chave de autenticação da ESP32 para POST /api/qrcode/scan-image
# Deve ser idêntica ao DEVICE_KEY definido no .ino do ESP32
# Deixe vazio para desabilitar a verificação (não recomendado em produção)
ESP32_DEVICE_KEY="esp32-secret-key"

# Limites do rate limiter global (opcional — valores padrão abaixo)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
